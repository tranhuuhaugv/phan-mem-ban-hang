// Schema database — Phần mềm quản lý kho laptop nội bộ
// Bảng khớp với kiểu nghiệp vụ ở src/lib/types.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== Enums =====

enum Role {
  admin
  manager
  staff
}

enum MachineStatus {
  ton_kho
  dat_coc
  dang_sua
  da_ban
  bao_hanh
}

enum Condition {
  cu
  like_new
  new
}

enum BuyReceiptStatus {
  cho_duyet
  da_duyet
  tu_choi
}

enum OrderStatus {
  cho_coc
  da_coc
  da_giao
  huy
}

enum RepairStatus {
  dang_sua
  cho_linh_kien
  hoan_tat
}

enum CashType {
  thu
  chi
}

enum AccountStatus {
  active
  locked
}

// ===== Bảng =====

// Máy trong kho — serial = Mã SP, khoá duy nhất
model Machine {
  id            String        @id @default(cuid())
  serial        String        @unique
  brand         String
  model         String
  cpu           String
  ram           String
  storage       String
  screen        String
  condition     Condition
  category      String? // loại sản phẩm: Laptop / Macbook / Phụ kiện...
  purchasePrice Int
  salePrice     Int? // giá bán niêm yết (tuỳ chọn)
  source        String
  status        MachineStatus @default(ton_kho)
  note          String?
  createdAt     DateTime      @default(now())
  createdByName String? // người tạo (nhập kho / duyệt thu máy)

  // Chi nhánh đang giữ máy + nhà cung cấp nhập máy (tuỳ chọn)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // Phiếu nhập kho (1 phiếu gồm nhiều máy)
  stockInId String?
  stockIn   StockIn? @relation(fields: [stockInId], references: [id])

  transferItems StockTransferItem[]

  orders       Order[]
  repairs      Repair[]
  warranties   Warranty[]
  invoiceItems InvoiceItem[]
  buyReceipt   BuyReceipt?
}

// Chi nhánh / cửa hàng
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  phone     String?
  note      String?
  createdAt DateTime @default(now())
  createdByName String? // người tạo

  machines      Machine[]
  stockIns      StockIn[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  repairs       Repair[]
}

// Nhà cung cấp — nguồn nhập hàng vào kho
model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  address   String?
  note      String?
  debt      Int      @default(0) // công nợ phải trả NCC (đồng)
  createdAt DateTime @default(now())
  createdByName String? // người tạo

  machines Machine[]
  stockIns StockIn[]
}

// Phiếu nhập kho — 1 phiếu gồm nhiều máy
model StockIn {
  id        String   @id @default(cuid())
  code      String   @unique // PN-0001
  date      DateTime @default(now())
  total     Int      @default(0)
  paid      Int      @default(0)
  debt      Int      @default(0)
  payMethod String? // tien_mat | chuyen_khoan
  note      String?
  createdAt DateTime @default(now())
  createdByName String? // người tạo

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  machines Machine[]
}

// Phiếu chuyển kho — chuyển máy từ chi nhánh này sang chi nhánh khác
model StockTransfer {
  id             String    @id @default(cuid())
  code           String    @unique // CK-0001
  status         String    @default("dang_chuyen") // dang_chuyen | da_nhan | huy
  senderNote     String? // ghi chú bên gửi
  receiverNote   String? // ghi chú bên nhận
  createdByName  String? // người tạo
  receivedByName String? // người nhận
  receivedAt     DateTime? // ngày nhận
  createdAt      DateTime  @default(now())

  fromBranchId String?
  fromBranch   Branch? @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String?
  toBranch     Branch? @relation("TransferTo", fields: [toBranchId], references: [id])

  items StockTransferItem[]
}

// Dòng máy trong phiếu chuyển
model StockTransferItem {
  id   String  @id @default(cuid())
  note String? // ghi chú cho sản phẩm chuyển

  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id])
}

// Danh mục = loại sản phẩm (Laptop / Macbook / Phụ kiện...)
model Category {
  id   String  @id @default(cuid())
  name String  @unique
  note String?
  createdByName String? // người tạo
}

// Phiếu thu máy (mua lại máy cũ từ khách)
model BuyReceipt {
  id           String           @id @default(cuid())
  code         String           @unique
  customerName String
  phone        String
  model        String
  config       String
  condition    String
  price        Int
  status       BuyReceiptStatus @default(cho_duyet)
  createdAt    DateTime         @default(now())
  createdByName String? // người tạo

  // Duyệt phiếu → tạo máy trong kho, gán vào đây
  machineId String?  @unique
  machine   Machine? @relation(fields: [machineId], references: [id])
}

// Đơn đặt hàng — gán máy cụ thể chống bán trùng
model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  customerName String
  phone        String
  sellPrice    Int
  deposit      Int         @default(0)
  status       OrderStatus @default(cho_coc)
  createdAt    DateTime    @default(now())
  createdByName String? // người tạo

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  invoices Invoice[]
}

// Phiếu sửa chữa
model Repair {
  id            String       @id @default(cuid())
  code          String       @unique
  machineName   String? // tên máy khi là máy khách mang tới (không có trong kho)
  customerName  String? // khách gửi sửa
  customerPhone String?
  errorDesc     String
  estCost       Int
  actualCost    Int?
  technician    String? // KTV nhận / phụ trách
  receiveDate   DateTime     @default(now())
  returnDate    DateTime?
  note          String? // ghi chú khi trả máy / linh kiện đã thay
  status        RepairStatus @default(dang_sua)
  createdByName String? // người tạo

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  invoices Invoice[]
}

// Phiếu thu / chi
model CashFlow {
  id       String   @id @default(cuid())
  code     String   @unique
  type     CashType
  date     DateTime @default(now())
  amount   Int
  content    String
  category   String
  partner    String?
  method     String? // hình thức: tien_mat | chuyen_khoan
  createdByName String? // người tạo
  supplierId String? // gắn phiếu chi với NCC (thanh toán nhập hàng)
  invoiceId  String? // gắn phiếu thu với hoá đơn (thanh toán bán hàng)
}

// Hoá đơn / phiếu thanh toán — gắn đơn hàng, phiếu sửa, hoặc bán trực tiếp
model Invoice {
  id           String   @id @default(cuid())
  code         String   @unique
  customerName String
  phone        String?
  total        Int
  paid         Int      @default(0) // đã thanh toán (còn nợ = total - paid)
  payMethod    String? // hình thức lần thu gần nhất: tien_mat | chuyen_khoan
  kind         String   @default("ban") // ban | don_hang | sua_chua
  createdAt    DateTime @default(now())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  repairId String?
  repair   Repair? @relation(fields: [repairId], references: [id])

  sellerId String?
  seller   Account? @relation(fields: [sellerId], references: [id])

  items      InvoiceItem[]
  warranties Warranty[]
}

// Dòng sản phẩm trong hoá đơn
model InvoiceItem {
  id     String @id @default(cuid())
  name   String
  config String
  price  Int

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])
}

// Phiếu bảo hành
model Warranty {
  id        String   @id @default(cuid())
  months    Int
  condition String
  startDate DateTime @default(now())

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
}

// Khách hàng
model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String  @unique
  address String?
  note    String?
  createdByName String? // người tạo

  orders Order[]
}

// Quyền theo vai trò + menu (chỉ lưu cho manager/staff — admin luôn toàn quyền)
model RolePermission {
  id        String  @id @default(cuid())
  role      Role
  menu      String
  view      Boolean @default(false)
  create    Boolean @default(false)
  edit      Boolean @default(false)
  remove    Boolean @default(false)
  approve   Boolean @default(false)
  seeProfit Boolean @default(false)
  seeReport Boolean @default(false)

  @@unique([role, menu])
}

// Cấu hình cửa hàng (1 dòng duy nhất) — hiển thị trên hoá đơn / mẫu in
model StoreConfig {
  id            String   @id @default("singleton")
  name          String   @default("")
  phone         String   @default("")
  address       String   @default("")
  logoUrl       String? // data URL (base64) của logo
  paperSize     String   @default("A5")
  defaultBranch String   @default("")
  thankYou      String   @default("")
  updatedAt     DateTime @updatedAt @default(now())
}

// Tài khoản đăng nhập
model Account {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  fullName     String
  role         Role          @default(staff)
  status       AccountStatus @default(active)
  lastLogin    DateTime?
  createdAt    DateTime      @default(now())

  sales Invoice[]
}

// Nhật ký thao tác — ai tạo/sửa/xoá phiếu, hoá đơn, thu chi...
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?
  userName String
  role     Role?
  action   String // create | update | delete | pay | approve | status
  entity   String // invoice | cashflow | stockin | order | repair | buy | machine
  code     String? // mã phiếu / hoá đơn
  detail   String? // mô tả ngắn

  @@index([at])
  @@index([entity])
}
